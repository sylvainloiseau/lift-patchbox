<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The parent of the two artifacts: lift-patchbox-core, the command model and its
       execution, and lift-patchbox-language, the two surface syntaxes and the
       command-line tool. It holds the specification, the versions, the plugin
       configuration and the release profile; it is published with them. -->
  <groupId>io.github.sylvainloiseau</groupId>
  <artifactId>lift-patchbox</artifactId>
  <version>0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.groupId}:${project.artifactId}</name>
  <description>LiftPatch, a mutation language for the LIFT dictionary data model: the parent
    of lift-patchbox-core (the command model, its validation and its transactional execution
    over the lift-api dictionary model) and lift-patchbox-language (the parsers of the two
    surface syntaxes and the command-line tool).</description>
  <url>https://github.com/sylvainloiseau/lift-patchbox</url>
  <licenses>
    <license>
      <name>Academic Free License v. 3.0</name>
      <url>https://opensource.org/license/AFL-3.0</url>
    </license>
  </licenses>
  <!-- Required by Maven Central: who develops the library, and where its sources are. -->
  <developers>
    <developer>
      <id>sylvainloiseau</id>
      <name>Sylvain Loiseau</name>
      <url>https://github.com/sylvainloiseau</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/sylvainloiseau/lift-patchbox.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sylvainloiseau/lift-patchbox.git</developerConnection>
    <url>https://github.com/sylvainloiseau/lift-patchbox</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>lift-patchbox-core</module>
    <module>lift-patchbox-language</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <lift-api.version>0.1.1</lift-api.version>
    <antlr.version>4.13.1</antlr.version>
    <picocli.version>4.7.6</picocli.version>
    <junit.version>6.1.0</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.sylvainloiseau</groupId>
        <artifactId>lift-patchbox-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.sylvainloiseau</groupId>
        <artifactId>lift-patchbox-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.github.sylvainloiseau</groupId>
        <artifactId>lift-api</artifactId>
        <version>${lift-api.version}</version>
      </dependency>
      <dependency>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-runtime</artifactId>
        <version>${antlr.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.antlr</groupId>
          <artifactId>antlr4-maven-plugin</artifactId>
          <version>${antlr.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <argLine>-Xmx2g</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>3.7.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
          <configuration>
            <!-- doclint is on, so that a missing @param or @return on a hand-written
                 class fails the check. The ANTLR-generated parsers of the language
                 module carry no comments and account for every warning the report
                 prints; they cannot be excluded by package, since they share one with
                 the hand-written parser classes, and they are left to warn rather than
                 turning the check off for everything. -->
            <doclint>all</doclint>
            <failOnWarnings>false</failOnWarnings>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Publishing to Maven Central: mvn -P release deploy (see .github/workflows/release.yml).
         Central requires a sources jar, a javadoc jar and a GPG signature of every file;
         the central-publishing plugin replaces the deploy phase and uploads them to the
         Central Portal, with the credentials of the server "central" in settings.xml. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE, without a prompt. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.12.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Released as soon as Central has validated the upload, and the build
                   waits for it, so that a failure shows in the workflow. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
