<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.sylvainloiseau</groupId>
    <artifactId>lift-patchbox</artifactId>
    <version>0.1-SNAPSHOT</version>
  </parent>

  <artifactId>lift-patchbox-core</artifactId>
  <packaging>jar</packaging>

  <name>${project.groupId}:${project.artifactId}</name>
  <description>The LiftPatch command model for the LIFT dictionary data model, independent of
    any surface syntax: a fluent builder, static validation against the metamodel, a plan
    (dry-run) mode, and a transactional executor over the lift-api dictionary model.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.sylvainloiseau</groupId>
      <artifactId>lift-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <!-- The test fixtures (the standard dictionary of Appendix D.2, the Tuwuli
               dictionary) and the engine test support, reused by the language tests. -->
          <execution>
            <id>test-jar</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
